+            completion_sim_s=s.get('T_complete_sim_s'),minimum_sampled_gap_m=v.get('trajectory',{}).get('minimum_gap_m'),
+            distance_m=metrics.get('total_distance_m'),reverse_distance_m=metrics.get('total_reverse_distance_m'),
