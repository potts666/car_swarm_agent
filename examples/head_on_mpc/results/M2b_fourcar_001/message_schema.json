  "storage_only_references": {
    "messages.payload": {
      "$plan": "complete plan ID"
    },
    "seed.states": {
      "$shift_states": "previous committed final ID",
      "skip": "10 dense samples",
      "tail": "10 explicit new states"
    },
    "diagnostic._details": {
      "$details": "SHA256 of stored numerical JSON body"
