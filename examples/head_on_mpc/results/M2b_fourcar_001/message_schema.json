    "context"
  ],
  "state_units": [
    "m",
    "m",
    "rad",
    "m/s",
    "rad"
  ],
  "context_fields": [
    "cycle",
    "state_time_s",
    "owner",
    "permission_version",
    "proposal_id",
    "conditional",
