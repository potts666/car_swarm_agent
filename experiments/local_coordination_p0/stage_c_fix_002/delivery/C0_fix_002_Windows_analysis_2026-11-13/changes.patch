+def fields(obj):
+    out={}
+    for k in dir(obj):
+        if k.startswith('_') or callable(getattr(obj,k)):continue
+        v=getattr(obj,k);out[k]=v if isinstance(v,(float,int,str,bool,list)) else str(v)
+    return out
